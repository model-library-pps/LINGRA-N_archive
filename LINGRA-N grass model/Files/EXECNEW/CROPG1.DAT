** CROP DATA FILE for use with LINGRAN, permanent grassland March 2012
** Based on WOFOST crop data set for WHEAT, WINTER 102 plus adaptations for grass
** Regions: North-central Europe
** start date 1 January


** emergence
TBASEM   =   0.0    ! lower threshold temp. for emergence [cel]
TEFFMX   =  30.0    ! max. eff. temp. for emergence [cel]
TSUMEM   =   60.    ! temperature sum from sowing/planting to emergence [cel d]

** phenology
IDSL     =   0      ! indicates whether pre-anthesis development depends
                    ! on temp. (=0) or both temperature and daylength (=1) 
PHOTTB   = 0.,  1., ! correction factor of development rate in dependence of day length [-]
           8.,  1., 
          10.,  1.,
          16.,  1.,
          18.,  1.
TSUM1    =   600.    ! temperature sum (for death rate of tillers) taken from TILSUB routine   [cel d]
TSUM2    =   0.    ! temperature sum from anthesis to maturity [cel d]
DTSMTB   =    0.00,   0.00,     ! daily increase in temp. sum
              3.00,   0.00,     ! as function of av. temp. [cel; cel d]
             33.00,   30.00,     
             45.00,   30.00
DVSI = 0.           ! initial DVS
DVSEND   =   10.00   ! development stage at harvest (not applicable; one DVS unit equal to 600 C.d)

** initial
TDWI     = 300.00   ! initial total crop dry weight [kg ha-1]
RGRLAI   =       1. ! maximum relative increase in LAI [ha ha-1 d-1] (not applied for grass)

** green area
SLATB    =   0.00,    0.0025,   ! specific leaf area  
             0.50,    0.0025,   ! as a function of DVS [-; ha kg-1]
             2.00,    0.0025
SPA      =   0.000  ! specific pod area [ha kg-1]
SSATB =  0.0, 0.0,  ! specific stem area [ha kg-1]
         2.0, 0.0   ! as function of DVS

LAICR    =   4.0    ! critical leaf area index for overshadowing [-]
TBASE    =   0.0    ! lower threshold temp. for increase in LAI [cel]

** assimilation
KDIFTB = 0.0, 0.60, ! extinction coefficient for diffuse visible light [-] 
         2.0, 0.60  ! as function of DVS
RUETB   =    0.00,   3.00,      ! radiation use efficiency for biomass production      
             1.00,   3.00,      ! as function of DVS (g DM/MJ PAR); 600 C.d  equal to one DVS unit
             3.00,   3.00,
             5.00,   1.00,
             6.00,   1.00
TMPFTB   =  -1.00,    0.00,     ! reduction factor of RUE
             3.00,    0.00,     ! as function of soil temp. (SOITMP) [cel; -]   
             8.00,    1.00,
            30.00,    1.00,
            35.00,    0.00,
            40.00,    0.00
TMNFTB   =   -5.00,    0.00,     ! red. factor of RUE
              0.00,    0.00,     ! as function of low min. temp. [cel; -]
              3.00,    1.00,      
             30.00,    1.00

RDDTB   =     0.00,    1.00,     ! red. factor of RUE
             10.00,    1.00,     ! as function of solar radiation per day [MJ m-2 d-1; -]
             40.00,    0.33,      
             42.00,    0.33

** correction of radiation use efficiency as a function of atmospheric CO2 concentration (-)
COTB       =  40., 0.00,
             360.,  1.00,
             720.,  1.25, 
            1000.,  1.35,
            2000.,  1.35


** partitioning
FRTB=        0.00,    0.165,     ! fraction of total dry matter to roots (without water stress)
             1.00,    0.165,     ! as a function of DVS [-; kg kg-1]; 600 C.d equal to one DVS unit
             3.00,    0.165

FLTB=        0.00,    1.00,     ! fraction of above-gr. DM to leaves (without water stress)
             1.00,    1.00,     ! as a function of DVS [-; kg kg-1]; 600 C.d equal to one DVS unit
             3.00,    1.00

FSTB=        0.00,    0.00,     ! fraction of above-gr. DM to stems
             1.00,    0.00,     ! as a function of DVS [-; kg kg-1]
             3.00,    0.00

FOTB=        0.00,    0.00,     ! fraction of above-gr. DM to stor. org.
             1.00,    0.00,     ! as a function of DVS [-; kg kg-1]
             3.00,    0.00

FRTRB=       -1.00,    1.60,     ! correction factor of DM fraction to roots 
              0.00,    1.60,     ! as a function of the transpiration coefficient (TRANRF, -)
              1.00,    1.00,
              1.20,    1.00
    

** death rates
RDRL     =   0.050          ! max. rel. death rate of leaves due to water stress [d-1]
RDRLTB   =   -10., 0.00,    ! relative death rate of leaves as a function of daily mean temperature [d-1]
              10., 0.01,
              15., 0.02,
              30., 0.05,
              50., 0.09
RDRSHM   =   0.030          ! rel. death rate of leaves due to shading (above LAICR) [d-1]
RDRRTB   =   0.00,    0.000,    ! rel. death rate of roots 
             3.00,    0.000    ! as a function of DVS [-; d-1]

RDRSTB   =   0.00,    0.000,    ! rel. death rate of stems
             3.00,    0.000    ! as a function of DVS [-;d-1]

** initial vaiables or grass crop
TILLI    =   7000.              ! initial number of tiller [m-2]
WREI     =    200.              ! dry weight of reserves (.e. storage carbohydrates) [kg ha-1] 

TMBAS1   =     3.               ! base temperature for leaf elongation [C]

** water use
CFET     =   1.00   ! correction factor transpiration rate [-]
DEPNR    =   3.5    ! crop group number for soil water depletion [-]
IAIRDU   =   0      ! air ducts in roots present (=1) or not (=0)

** rooting
RDI      =  40.     ! initial rooting depth [cm]
RRI      =   1.2    ! maximum daily increase in rooting depth [cm d-1]
RDMCR    =  40.     ! maximum rooting depth [cm]

DVSDLT   =  1.0     ! development stage above which death of leaves starts in dependence of mean daily temperature (600 C.d per unit DVS)

** nitrogen use
RDRNS    = 0.05     ! max. relative death rate of leaves due to N stress
DVSNLT   = 10.0      ! development stage above which no crop nitrogen uptake does occur
DVSNT    = 10.0      ! development stage above which nitrogen translocation to storage organs does occur [NOT USED]
FNTRT    = 0.15     ! nitrogen translocation from roots as a fraction of total N amount translocated from leaves and stems
FRNX     = 1.00     ! optimal N concentration as fraction of maximum N concentration
LRNR     = 0.50     ! maximum N concentration in roots as fraction of maximum N concentration in leaves
LSNR     = 0.50     ! maximum N concentration in stems as fraction of maximum N concentration in leaves
NLAI     = 1.0      ! coefficient for the reduction due to N stress of the LAI increase (during juvenile phase; NOT USED)
NLUE     = 1.1      ! coefficient for the reduction of RUE due to  Nitrogen stress
NMAXSO   = 0.000    ! maximum N concentration (= 1.6*min. N conc.) in storage organs [kg N kg-1 dry biomass]
NPART    = 1.0      ! coefficient for the effect of N stress on leaf biomass reduction [NOT USED]
NSLA     = 0.5      ! coefficient for the effect of N stress on SLA reduction
RNFLV    = 0.010    ! residual N fraction in leaves [kg N kg-1 dry biomass]
RNFST    = 0.005    ! residual N fraction in stems [kg N kg-1 dry biomass]
RNFRT    = 0.005    ! residual N fraction in roots [kg N kg-1 dry biomass]
TCNT     = 10.      ! time coefficient for N translocation to storage organs [days; NOT USED]
NFIXF    = 0.00     ! fraction of crop nitrogen uptake by biological fixation [-; NOT USED]

NMXLV    =  0.0, 0.035,   ! maximum N concentration in leaves as function of development stage [kg N kg-1 dry biomass] (600 c*d per unit DVS)
            3.0, 0.035,
            5.0, 0.035